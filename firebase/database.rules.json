{
  "rules": {
    "requests": {
      ".read": false,
      "$uid": {
        "$reqId": {
          ".write": "!data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['action', 'timestamp']) && newData.child('action').isString()"
        }
      }
    },
    "responses": {
      ".read": false,
      "$uid": {
        ".read": false,
        "$reqId": {
          ".read": true,
          ".write": "data.exists() && !newData.exists()"
        }
      }
    }
  }
}
