# Firebase Hosting site, automated configuration generation, build, and release

# Firebase Hosting Site resource
resource "google_firebase_hosting_site" "default" {
  provider = google-beta
  project  = var.project_id
  site_id  = var.project_id

  depends_on = [
    google_firebase_project.default,
    google_project_service.services["firebasehosting.googleapis.com"]
  ]
}

# Automatically generate webapp/.env.production with live project parameters
resource "local_file" "webapp_env_production" {
  filename = "${path.module}/../webapp/.env.production"
  content  = <<-EOT
    # Auto-generated by OpenTofu for production deployment
    VITE_FIREBASE_API_KEY="${data.google_firebase_web_app_config.default.api_key}"
    VITE_FIREBASE_PROJECT_ID="${var.project_id}"
    VITE_FIREBASE_DATABASE_URL="${google_firebase_database_instance.rtdb.database_url}"
  EOT
}

# Automatically generate webapp/firebase.json so manual 'firebase init' is not required
resource "local_file" "webapp_firebase_json" {
  filename = "${path.module}/../webapp/firebase.json"
  content  = <<-EOT
    {
      "hosting": {
        "public": "dist",
        "ignore": [
          "firebase.json",
          "**/.*",
          "**/node_modules/**"
        ],
        "rewrites": [
          {
            "source": "**",
            "destination": "/index.html"
          }
        ]
      }
    }
  EOT
}

# Build and release webapp to Firebase Hosting
resource "terraform_data" "webapp_build_and_deploy" {
  input = {
    env_content   = local_file.webapp_env_production.content
    firebase_json = local_file.webapp_firebase_json.content
    package_json  = filesha256("${path.module}/../webapp/package.json")
  }

  provisioner "local-exec" {
    working_dir = "${path.module}/../webapp"
    command     = <<-EOT
      set -e
      echo "Building production webapp bundle..."
      if ! command -v npm >/dev/null 2>&1; then
        echo "Error: npm is not installed or not in PATH."
        exit 1
      fi

      if [ ! -d "node_modules" ]; then
        echo "Installing webapp dependencies..."
        npm ci || npm install
      fi

      npm run build

      echo "Deploying to Firebase Hosting site '${var.project_id}'..."
      if command -v firebase >/dev/null 2>&1; then
        firebase deploy --only hosting --project "${var.project_id}"
      else
        echo "Notice: Firebase CLI (firebase-tools) not found in PATH."
        echo "The webapp bundle was built to webapp/dist/."
        echo "To complete live hosting deployment, install firebase-tools and run:"
        echo "  cd webapp && firebase deploy --only hosting --project ${var.project_id}"
      fi
    EOT
  }

  depends_on = [
    local_file.webapp_env_production,
    local_file.webapp_firebase_json,
    google_firebase_hosting_site.default
  ]
}
